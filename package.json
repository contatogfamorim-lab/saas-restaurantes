{
  "name": "pedidos-ia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start -x studio,edge-runtime,logflare,vector,supavisor,imgproxy,mailpit",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:check-rls": "node --env-file-if-exists=.env.local scripts/check-rls.mts",
    "check:secrets": "node --env-file-if-exists=.env.local scripts/check-bundle-secrets.mts",
    "verify": "node --env-file-if-exists=.env.local scripts/verify.mts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "db:photos": "node --env-file=.env.local scripts/seed-photos.mts",
    "db:modelos": "node --env-file=.env.local scripts/seed-modelos.mts",
    "modelos:gerar": "node --env-file=.env.local scripts/gerar-modelos-dos-produtos.mts",
    "db:salao": "node --env-file=.env.local scripts/seed-salao.mts",
    "db:historico": "node --env-file=.env.local scripts/seed-historico.mts",
    "check:routes": "node --env-file=.env.local scripts/check-routes.mts",
    "check:realtime": "node --env-file=.env.local scripts/check-realtime.mts",
    "check:forca-bruta": "node --env-file=.env.local scripts/check-forca-bruta.mts",
    "check:imagens": "node scripts/check-imagens.mts",
    "check:csp": "node --env-file=.env.local scripts/check-csp.mts",
    "check:portas": "node --env-file-if-exists=.env.local scripts/check-portas-novas.mts",
    "check:avisos": "node --env-file-if-exists=.env.local scripts/check-avisos-do-cliente.mts",
    "check:whatsapp": "node --conditions=react-server --env-file-if-exists=.env.local scripts/check-conexao-whatsapp.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "6.2.10",
    "lucide-react": "^1.33.0",
    "nanoid": "6.0.1",
    "next": "16.3.2",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@gradio/client": "^2.5.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "17.4.2",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "meshoptimizer": "^1.2.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "supabase": "2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
