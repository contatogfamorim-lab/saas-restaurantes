# =============================================================================
# Copie para .env.local e preencha. .env* NUNCA vai para o git (spec §10.10).
# Em produção, os valores ficam no cofre do provedor de deploy — não em arquivo.
# =============================================================================

# --- Público: vai para o browser, por design ---------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Servidor: JAMAIS com prefixo NEXT_PUBLIC_ -------------------------------
# Ignora RLS. Vazar esta chave entrega o banco inteiro, de todos os tenants.
# `pnpm check:secrets` varre o bundle e falha o build se ela aparecer.
SUPABASE_SERVICE_ROLE_KEY=""

# Assina o cookie httpOnly da sessão de mesa (spec §10.4).
# Gere com: openssl rand -base64 48
SESSION_COOKIE_SECRET=""

# Conexão direta com o Postgres, usada por `pnpm db:check-rls`.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- WhatsApp (Evolution API) e disparo de campanhas -------------------------
# Todas OPCIONAIS: sem elas o sistema sobe normalmente, só não manda mensagem.
#
# Servidor da Evolution é um só para toda a instalação. O que muda por
# restaurante é o nome da instância, que fica em
# `restaurants.evolution_instance_name` — configurado pelo dono, no painel.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

# Protege /api/marketing/tick, que é quem dispara as campanhas.
# Sem este valor a rota responde 401 para todo mundo — inclusive em
# desenvolvimento. É de propósito: liberar quando falta configuração deixaria
# um endereço público capaz de disparar campanha de qualquer casa.
# Gere com: openssl rand -base64 36
MARKETING_WORKER_SECRET=""

# Token do Hugging Face, para a digitalização 3D dos pratos.
#
# O gerador é o TRELLIS.2 (MIT), rodando no Space público do Hugging Face em
# ZeroGPU. Sem token a cota anônima é ZERO — testado: a geração pede 60s de GPU
# e o saldo responde "0s left" —, então o `pnpm modelos:gerar` não sai do lugar.
#
# Conta gratuita em https://huggingface.co/join
# Token em https://huggingface.co/settings/tokens (tipo: Read)
#
# A cota gratuita não cobre um cardápio inteiro num dia só. O script processa um
# prato por vez e retoma de onde parou, então dá para ir em lotes; quem quiser
# tudo de uma vez precisa do plano PRO.
HF_TOKEN=""
